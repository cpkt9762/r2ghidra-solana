--- a/src/Processors/sBPF/data/languages/sBPF.sinc
+++ b/src/Processors/sBPF/data/languages/sBPF.sinc
@@ -14,6 +14,15 @@
 # Instruction encoding: Insop:8, dst_reg:4, src_reg:4, off:16, imm:32 - from lsb to msb
 define token instr(64)
 	imm=(32, 63) signed
+	callx_imm_reg=(32, 35)
+	callx_imm_nibble0=(32, 35)
+	callx_imm_nibble1=(36, 39)
+	callx_imm_nibble2=(40, 43)
+	callx_imm_nibble3=(44, 47)
+	callx_imm_nibble4=(48, 51)
+	callx_imm_nibble5=(52, 55)
+	callx_imm_nibble6=(56, 59)
+	callx_imm_nibble7=(60, 63)
 	off=(16, 31) signed
 	src=(12, 15)
 	dst=(8, 11)
@@ -32,6 +41,8 @@
 #To operate with registers
 attach variables [ src dst ] [  R0  R1  R2  R3  R4  R5  R6  R7  R8  R9  R10  _  _  _  _  _  ];
 
+attach variables [ callx_imm_reg ] [ R0 R1 R2 R3 R4 R5 R6 R7 R8 R9 R10 _ _ _ _ _ ];
+
 #Arithmetic instructions
 ###############################################################################
 
@@ -267,4 +278,20 @@
 	call SysCall;
 }
 
+# v0 encodes the target register in imm; current v3 (SIMD-0377) uses dst, and imm=0 gives the same result for v0 callx r0.
+# Bound pattern expansion with eight mutually exclusive four-bit tests for imm!=0.
+:CALLX callx_imm_reg is callx_imm_reg &
+    ((callx_imm_nibble0!=0)
+     | (callx_imm_nibble0=0 & callx_imm_nibble1!=0)
+     | (callx_imm_nibble0=0 & callx_imm_nibble1=0 & callx_imm_nibble2!=0)
+     | (callx_imm_nibble0=0 & callx_imm_nibble1=0 & callx_imm_nibble2=0 & callx_imm_nibble3!=0)
+     | (callx_imm_nibble0=0 & callx_imm_nibble1=0 & callx_imm_nibble2=0 & callx_imm_nibble3=0 & callx_imm_nibble4!=0)
+     | (callx_imm_nibble0=0 & callx_imm_nibble1=0 & callx_imm_nibble2=0 & callx_imm_nibble3=0 & callx_imm_nibble4=0 & callx_imm_nibble5!=0)
+     | (callx_imm_nibble0=0 & callx_imm_nibble1=0 & callx_imm_nibble2=0 & callx_imm_nibble3=0 & callx_imm_nibble4=0 & callx_imm_nibble5=0 & callx_imm_nibble6!=0)
+     | (callx_imm_nibble0=0 & callx_imm_nibble1=0 & callx_imm_nibble2=0 & callx_imm_nibble3=0 & callx_imm_nibble4=0 & callx_imm_nibble5=0 & callx_imm_nibble6=0 & callx_imm_nibble7!=0)) &
+    op_alu_jmp_opcode=0x8 & op_alu_jmp_source=1 & op_insn_class=0x5 {
+    call [callx_imm_reg];
+}
+:CALLX dst is dst & imm=0 & op_alu_jmp_opcode=0x8 & op_alu_jmp_source=1 & op_insn_class=0x5 { call [dst]; }
+
 :EXIT is op_alu_jmp_opcode=0x9 & op_alu_jmp_source=0 & op_insn_class=0x5 { return [*:8 R10]; }
